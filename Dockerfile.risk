# --- Builder stage ---
FROM rust:1.88 AS builder

WORKDIR /app

# Dependency caching: copy manifests and build dummy projects
COPY Cargo.toml Cargo.lock ./
COPY shared/Cargo.toml shared/Cargo.toml
COPY api-service/Cargo.toml api-service/Cargo.toml
COPY risk-processor/Cargo.toml risk-processor/Cargo.toml

RUN mkdir -p shared/src api-service/src risk-processor/src \
    && echo "// dummy" > shared/src/lib.rs \
    && echo "fn main() {}" > api-service/src/main.rs \
    && echo "fn main() {}" > risk-processor/src/main.rs \
    && cargo build --release -p risk-processor \
    && rm -rf shared/src risk-processor/src \
    && rm -f target/release/deps/shared* target/release/deps/risk_processor* target/release/deps/libshared*

# Copy real source and rebuild (api-service dummy stays to satisfy workspace)
COPY shared/src shared/src
COPY risk-processor/src risk-processor/src

RUN cargo build --release -p risk-processor

# --- Runtime stage ---
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/risk-processor /usr/local/bin/risk-processor

CMD ["risk-processor"]
